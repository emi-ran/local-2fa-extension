{
  "manifest_version": 3,
  "name": "Local 2FA Authenticator",
  "version": "1.0.0",
  "description": "Local encrypted 2FA/TOTP code generator.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "2FA Authenticator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
